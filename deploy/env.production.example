APP_NAME="Y.P. Seaton & Associates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.ypseaton.com
APP_TIMEZONE=America/Jamaica
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_yps
DB_USERNAME=u000000000_yps
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail.
# ypseaton.com mail is on Microsoft 365 (MX ypseaton-com.mail.protection.outlook.com), so send
# through a licensed M365 mailbox with SMTP AUTH enabled, or add Hostinger to the SPF record first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@ypseaton.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@ypseaton.com
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Set false at launch.
YPS_PREVIEW=false
YPS_PUBLIC_EMAIL=info@ypseaton.com
# Who is emailed about new submissions, comma separated. Each area falls back to YPS_NOTIFY_EMAIL.
YPS_NOTIFY_EMAIL=
YPS_NOTIFY_TENDERS=
YPS_NOTIFY_PREQUAL=
YPS_NOTIFY_CAREERS=
YPS_NOTIFY_ENQUIRIES=
YPS_NOTIFY_ROOMS=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
